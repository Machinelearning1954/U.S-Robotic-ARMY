{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Facilities",
  "description": "Registry of headquarters and facilities for the U.S. Robotic Army project.",
  "type": "object",
  "required": ["facilities"],
  "properties": {
    "facilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "organization", "type", "status", "city", "country"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique, kebab-case identifier for the facility."
          },
          "name": { "type": "string" },
          "organization": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["headquarters", "base", "outpost", "depot", "command-center"]
          },
          "status": {
            "type": "string",
            "enum": ["active", "planned", "inactive", "decommissioned"]
          },
          "city": { "type": "string" },
          "region": { "type": "string" },
          "country": { "type": "string" },
          "coordinates": {
            "type": "object",
            "required": ["latitude", "longitude"],
            "properties": {
              "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
              "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
            }
          },
          "timezone": { "type": "string" },
          "established": {
            "type": "string",
            "description": "ISO 8601 date the facility was established."
          }
        }
      }
    }
  }
}
